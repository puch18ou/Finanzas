{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidades base de la app de escritorio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "opener:default",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "finanzas-install://*" }]
    },
    "fs:allow-mkdir",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**/*" },
        { "path": "$APPCACHE" },
        { "path": "$APPCACHE/**/*" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.finance.yahoo.com/*" },
        { "url": "https://query1.finance.yahoo.com/*" },
        { "url": "https://query2.finance.yahoo.com/*" },
        { "url": "https://markets.ft.com/*" },
        { "url": "https://stooq.com/*" },
        { "url": "https://api.frankfurter.dev/*" },
        { "url": "https://api.frankfurter.app/*" },
        { "url": "https://api.github.com/*" },
        { "url": "https://github.com/*" },
        { "url": "https://*.githubusercontent.com/*" },
        { "url": "http://10.138.1.156:8787/*" },
        { "url": "http://192.168.*.*:*/*" },
        { "url": "http://10.*.*.*:*/*" },
        { "url": "http://172.*.*.*:*/*" },
        { "url": "http://*/*" }
      ]
    }
  ]
}
