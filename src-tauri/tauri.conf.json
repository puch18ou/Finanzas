{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finanzas",
  "version": "0.1.20",
  "identifier": "personal.finanzas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Finanzas",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": []
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NUJCRkY2MzhBNTE1NjIKUldSaUZhVTQ5cjlicE1lcU5aamZLemJxamtDVGJwdnRoL0IxakdhT3BWYkdEOVM0aUJKbWVkMDUK",
      "endpoints": [
        "https://github.com/puch18ou/Finanzas/releases/latest/download/latest.json"
      ]
    }
  }
}
